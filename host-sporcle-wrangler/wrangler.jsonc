{
  "name": "host-sporcle-wrangler",
  "main": "src/index.js",
  "compatibility_date": "2026-04-03",
  "services": [
    {
      "binding": "MUSIC_GAME",
      "service": "music-game-wrangler"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HOST_SPORCLE", "class_name": "HostSporcle" }
    ]
  },
  "exports": {
    "HostSporcle": { "type": "durable-object", "storage": "sqlite" }
  }
}