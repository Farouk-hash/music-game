{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "music-game-wrangler",
	"main": "src/index.js",
	"compatibility_date": "2026-09-26",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "music-game-db",
			"database_id": "9593ff09-cf39-486d-9ca0-381371190378",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "AUDIO",
			"bucket_name": "music-game-audio",
			"remote": true
		}
	],
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		}
	},
	"kv_namespaces": [
		{
			"binding": "CATALOG_CACHE",
			"id": "304cb7d7b2584a089a35b1d0b27da591",
			"remote": true
		}
	]
}